# Copy this file to `.env` and fill in real values.
# Never commit the real .env — it's gitignored.

# Telegram bot token from @BotFather
BOT_TOKEN=123456:replace-me

# Postgres connection
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market_db

# Telegram user_id of the main admin (will be auto-promoted on first launch).
# Get yours from @userinfobot.
MAIN_ADMIN_ID=
